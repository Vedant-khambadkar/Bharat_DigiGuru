# ==============================================================================
# BHARAT DIGIGURU BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Comma-separated allowed origins or * for open development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://digiguru-mockup.netlify.app

# JWT Secret Key for Admin Authentication (Token Signing & Verification)
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Connection URI (Atlas Cluster or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bharat_digiguru?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Optional: SMTP / Email Service Configuration (For Password Reset OTP Delivery)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Bharat DigiGuru Security" <no-reply@bharatdigiguru.com>

# Or for direct Gmail service:
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password
